---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: [ImageMetadata, ImageMetadata];
  alts: [string, string];
  loading?: 'eager' | 'lazy';
}

const { images, alts, loading = 'lazy' } = Astro.props;
---
<div class="image-pair">
  {images.map((image, index) => (
    <Image src={image} alt={alts[index]} widths={[480, 768, 1024]} sizes="(max-width: 700px) 100vw, 42vw" loading={loading} />
  ))}
</div>
